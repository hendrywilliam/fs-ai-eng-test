# Copy to .env for local development:  cp .env.example .env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodevadesk?schema=public

# Any OpenAI-compatible endpoint. The values below are the ones this project
# actually uses, namely DeepSeek through OpenRouter. Point LLM_BASE_URL and
# LLM_MODEL elsewhere (OpenAI, Groq, vLLM, Ollama, LM Studio, ...) to switch
# without code changes.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=500

# Reuse a previous classification instead of calling the provider again when a
# ticket repeats. Matching a merely similar ticket needs RediSearch, which the
# redis-stack image provides; with plain Redis only exact matches are reused.
# Set LLM_CACHE_SIMILARITY_THRESHOLD to 1 to reuse only identical tickets.
LLM_CACHE_ENABLED=true
LLM_CACHE_SIMILARITY_THRESHOLD=0.85
LLM_CACHE_TTL_SECONDS=86400

# Optional Redis cache for ticket reads. Leave REDIS_URL empty to disable it
# entirely, so every read goes straight to PostgreSQL. If Redis is configured but
# down at runtime, reads fall back to PostgreSQL instead of failing.
# REDIS_URL=redis://localhost:6379
# TICKET_CACHE_TTL_SECONDS=300

# Only needed to run the database-backed e2e suite. Kept separate from
# DATABASE_URL on purpose, so those destructive tests can never hit a
# development database by accident.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodevadesk_test?schema=public
